{
  "name": "csv-nyaan-viewer",
  "version": "1.0.2",
  "description": "Windows\u7528\u306e\u975e\u7834\u58caCSV\u30d3\u30e5\u30fc\u30ef\u30fc",
  "private": true,
  "author": "CSV nyaan Viewer",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "iconv-lite": "0.7.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "markdown-it": "14.1.0",
    "dompurify": "3.3.0",
    "@types/markdown-it": "14.1.2",
    "chart.js": "4.5.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "42.0.0",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  },
  "build": {
    "appId": "local.csvnyaan.viewer",
    "productName": "CSV nyaan Viewer",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "zip",
      "signAndEditExecutable": false,
      "artifactName": "CSV-nyaan-Viewer-${version}-Windows-x64.zip"
    },
    "linux": {
      "target": "dir",
      "category": "Utility"
    },
    "extraFiles": [
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "samples",
        "to": "samples"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ]
  }
}
