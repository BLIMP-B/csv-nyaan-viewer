{
  "name": "csv-nyaan-viewer",
  "version": "1.5.6",
  "description": "Windows用の非破壊CSVビューワー",
  "private": true,
  "author": "CSV nyaan Viewer",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win zip --x64",
    "dist:linux": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@types/markdown-it": "14.1.2",
    "dompurify": "3.3.0",
    "echarts": "^5.6.0",
    "exceljs": "4.4.0",
    "gifenc": "^1.0.3",
    "i18n-iso-countries": "^7.14.0",
    "iconv-lite": "0.7.2",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "markdown-it": "14.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "42.0.0",
    "electron-builder": "26.0.12",
    "omggif": "^1.0.10",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  },
  "build": {
    "appId": "local.csvnyaan.viewer",
    "productName": "CSV nyaan Viewer",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "zip",
      "signAndEditExecutable": true,
      "artifactName": "CSV-nyaan-Viewer-${version}-Windows-x64.zip",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "dir",
      "category": "Utility"
    },
    "extraFiles": [
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "samples",
        "to": "samples"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ]
  }
}
